# These Vite variables are embedded in the browser bundle.
# Use only your Supabase project's public anon/publishable key here.
# Never use a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Must match the slug of a published row in public.restaurants.
# Defaults to "aurelia" when omitted.
VITE_RESTAURANT_SLUG=aurelia